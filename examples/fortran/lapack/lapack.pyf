        end subroutine dgeequb
        subroutine dgesc2(n,a,lda,rhs,ipiv,jpiv,scale)
            integer :: n
            double precision dimension(lda,*) :: a
            integer, optional,check(shape(a, 0) == lda),depend(a) :: lda=shape(a, 0)
            double precision dimension(*) :: rhs
